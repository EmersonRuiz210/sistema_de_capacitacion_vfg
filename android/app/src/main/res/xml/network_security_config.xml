<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permitir HTTP sin cifrar solo en desarrollo -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- IP local de tu PC -->
        <domain includeSubdomains="true">192.168.x.x</domain>
        
        <!-- Para cualquier otra IP local (opcional) -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        
        <!-- Para tu propia PC cuando uses localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>